{
  "name": "MP Upper/Lower — Shoulder Priority",
  "weeks": 5,
  "volumeTargets": [
    { "muscleGroup": "shoulders", "mev": 10, "mav": 16, "mrv": 20 },
    { "muscleGroup": "back",      "mev": 10, "mav": 16, "mrv": 20 },
    { "muscleGroup": "chest",     "mev": 8,  "mav": 12, "mrv": 16 },
    { "muscleGroup": "biceps",    "mev": 6,  "mav": 10, "mrv": 14 },
    { "muscleGroup": "triceps",   "mev": 6,  "mav": 10, "mrv": 14 },
    { "muscleGroup": "quads",     "mev": 8,  "mav": 12, "mrv": 16 },
    { "muscleGroup": "hamstrings","mev": 6,  "mav": 10, "mrv": 14 },
    { "muscleGroup": "calves",    "mev": 6,  "mav": 10, "mrv": 14 },
    { "muscleGroup": "abs",       "mev": 6,  "mav": 10, "mrv": 14 }
  ],
  "sessions": [
    {
      "name": "Upper A — Shoulders & Back Width",
      "dayOfWeek": 1,
      "order": 0,
      "muscleGroups": ["shoulders", "back", "biceps"],
      "exercises": [
        { "name": "Overhead Press Dumbbell", "repRangeMin": 10, "repRangeMax": 12, "targetSets": 4, "setType": "regular" },
        { "name": "Cable Lateral Raise",     "repRangeMin": 12, "repRangeMax": 15, "targetSets": 4, "setType": "regular" },
        { "name": "Machine Lateral Raise",   "repRangeMin": 12, "repRangeMax": 15, "targetSets": 3, "setType": "regular" },
        { "name": "Lat Pulldown",            "repRangeMin": 10, "repRangeMax": 12, "targetSets": 4, "setType": "regular" },
        { "name": "Single-Arm Cable Row",    "repRangeMin": 10, "repRangeMax": 12, "targetSets": 3, "setType": "regular" },
        { "name": "Cable Face Pull",         "repRangeMin": 15, "repRangeMax": 20, "targetSets": 3, "setType": "regular" },
        { "name": "Incline Dumbbell Curl",   "repRangeMin": 10, "repRangeMax": 12, "targetSets": 3, "setType": "regular" }
      ]
    },
    {
      "name": "Lower A",
      "dayOfWeek": 2,
      "order": 1,
      "muscleGroups": ["quads", "hamstrings", "calves"],
      "exercises": [
        { "name": "Leg Press",          "repRangeMin": 10, "repRangeMax": 12, "targetSets": 4, "setType": "regular" },
        { "name": "Leg Extension",      "repRangeMin": 12, "repRangeMax": 15, "targetSets": 3, "setType": "regular" },
        { "name": "Lying Leg Curl",     "repRangeMin": 10, "repRangeMax": 12, "targetSets": 3, "setType": "regular" },
        { "name": "Seated Leg Curl",    "repRangeMin": 10, "repRangeMax": 12, "targetSets": 3, "setType": "regular" },
        { "name": "Standing Calf Raise","repRangeMin": 15, "repRangeMax": 20, "targetSets": 4, "setType": "regular" }
      ]
    },
    {
      "name": "Upper B — Chest, Back & Arms",
      "dayOfWeek": 4,
      "order": 2,
      "muscleGroups": ["chest", "shoulders", "back", "biceps", "triceps"],
      "exercises": [
        { "name": "Incline Dumbbell Press", "repRangeMin": 8,  "repRangeMax": 12, "targetSets": 4, "setType": "regular" },
        { "name": "Cable Lateral Raise",    "repRangeMin": 12, "repRangeMax": 15, "targetSets": 3, "setType": "regular" },
        { "name": "Barbell Row",            "repRangeMin": 8,  "repRangeMax": 12, "targetSets": 4, "setType": "regular" },
        { "name": "Incline Cable Fly",      "repRangeMin": 12, "repRangeMax": 15, "targetSets": 3, "setType": "regular" },
        { "name": "Rear Delt Fly Machine",  "repRangeMin": 15, "repRangeMax": 20, "targetSets": 3, "setType": "regular" },
        { "name": "Cable Pushdown",         "repRangeMin": 10, "repRangeMax": 12, "targetSets": 3, "setType": "regular" },
        { "name": "Cable Curl",             "repRangeMin": 10, "repRangeMax": 12, "targetSets": 3, "setType": "regular" }
      ]
    },
    {
      "name": "Lower B + Abs",
      "dayOfWeek": 5,
      "order": 3,
      "muscleGroups": ["quads", "hamstrings", "calves", "abs"],
      "exercises": [
        { "name": "Hack Squat Machine",        "repRangeMin": 10, "repRangeMax": 12, "targetSets": 4, "setType": "regular" },
        { "name": "Bulgarian Split Squat",     "repRangeMin": 10, "repRangeMax": 12, "targetSets": 3, "setType": "regular" },
        { "name": "Dumbbell Romanian Deadlift","repRangeMin": 10, "repRangeMax": 12, "targetSets": 3, "setType": "regular" },
        { "name": "Seated Leg Curl",           "repRangeMin": 10, "repRangeMax": 12, "targetSets": 3, "setType": "regular" },
        { "name": "Seated Calf Raise",         "repRangeMin": 15, "repRangeMax": 20, "targetSets": 4, "setType": "regular" },
        { "name": "Cable Crunch",              "repRangeMin": 12, "repRangeMax": 15, "targetSets": 4, "setType": "regular" },
        { "name": "Hanging Leg Raise",         "repRangeMin": 10, "repRangeMax": 12, "targetSets": 3, "setType": "regular" }
      ]
    }
  ]
}
